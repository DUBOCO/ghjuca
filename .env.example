# Clé secrète Stripe (mode test ou live) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# URL publique du site, utilisée pour les redirections Stripe (optionnel en local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données Postgres (catalogue produits) — ajoutée automatiquement par
# l'intégration "Postgres" de Vercel (Storage → Create Database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mot de passe du back office (/admin) — choisis-en un solide
ADMIN_PASSWORD=change-moi
